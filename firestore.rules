rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write only their own user document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow authenticated users to read/write only their own subcollections
    match /users/{uid}/clothing/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/outfits/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/wearHistory/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/outfitSchedule/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/trips/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/coachMessages/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
